# Copier en .env.local (application) et .env (Prisma CLI), puis compléter.

# ── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://chronova:chronova@127.0.0.1:5432/chronova?schema=public"

# ── Authentification (Auth.js) ───────────────────────────────────────────────
# Générer avec : npx auth secret
AUTH_SECRET=""
# URL publique du site, sans barre oblique finale.
AUTH_URL="http://localhost:3000"

# ── E-mails transactionnels (Resend) ─────────────────────────────────────────
# Sans clé, les liens de connexion sont écrits dans la console du serveur au
# lieu d'être envoyés : pratique en développement, refusé en production.
RESEND_API_KEY=""
RESEND_FROM="Chronova <atelier@exemple.fr>"

# ── Paiement (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Divers ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
